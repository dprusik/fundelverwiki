{
    "name": "web",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "prebuild": "node scripts/publication.cjs legacy && rimraf dist",
        "dev": "node scripts/publication.cjs legacy && npm-run-all get-theme build:sass --parallel watch:*",
        "watch:sass": "node scripts/publication.cjs legacy && sass --watch src/site/styles:dist/styles",
        "watch:eleventy": "cross-env ELEVENTY_ENV=dev eleventy --serve",
        "build:eleventy": "cross-env ELEVENTY_ENV=prod UV_THREADPOOL_SIZE=16 NODE_OPTIONS=--max-old-space-size=2048 eleventy",
        "build:sass": "node scripts/publication.cjs legacy && sass src/site/styles:dist/styles --style compressed",
        "get-theme": "node scripts/publication.cjs legacy && node src/site/get-theme.js",
        "build": "npm-run-all get-theme build:*",
        "test": "vitest run",
        "wiki:build": "node scripts/wiki-preview.mjs",
        "wiki:dev": "node scripts/wiki-preview.mjs --serve",
        "wiki:test": "node --test tests/wiki/demo.test.mjs tests/wiki/catalog.test.cjs",
        "publication:inventory": "node scripts/publication.cjs inventory",
        "publication:validate": "node scripts/publication.cjs validate",
        "publication:data": "node scripts/publication.cjs data",
        "publication:test": "node --test tests/security/*.test.cjs",
        "publication:review": "node scripts/publication-review.cjs",
        "publication:compare": "node scripts/compare-publication.cjs",
        "publication:import": "node scripts/publication-import.cjs",
        "publication:status": "node scripts/publication-import.cjs status",
        "publication:map-check": "node scripts/map-browser-check.cjs"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "engines": {
        "node": "22.x"
    },
    "devDependencies": {
        "@11ty/eleventy": "^3.1.2",
        "@11ty/eleventy-plugin-rss": "^2.0.4",
        "cross-env": "^10.1.0",
        "html-minifier-terser": "^7.2.0",
        "node-html-parser": "^7.0.2",
        "sass": "^1.49.9",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@11ty/eleventy-img": "^4.0.2",
        "@sindresorhus/slugify": "^1.1.0",
        "axios": "^1.2.2",
        "dotenv": "^16.0.3",
        "eleventy-plugin-gen-favicons": "^1.1.2",
        "eleventy-plugin-nesting-toc": "^1.3.0",
        "fs-file-tree": "^1.1.1",
        "glob": "^10.2.1",
        "gray-matter": "^4.0.3",
        "jsep": "^1.4.0",
        "markdown-it": "^14.1.0",
        "markdown-it-anchor": "^9.0.1",
        "markdown-it-attrs": "^4.1.6",
        "markdown-it-footnote": "^3.0.3",
        "markdown-it-mark": "^4.0.0",
        "markdown-it-mathjax3": "^4.3.1",
        "markdown-it-plantuml": "^1.4.1",
        "markdown-it-task-checkbox": "^1.0.6",
        "npm-run-all": "^4.1.5",
        "rimraf": "^4.4.1",
        "yaml": "^2.8.3"
    }
}
