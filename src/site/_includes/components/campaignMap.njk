<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script>
(function () {
  function loadScript(src, callback) {
    if (window.L) {
      callback();
      return;
    }

    const existingScript = document.querySelector('script[src="' + src + '"]');
    if (existingScript) {
      existingScript.addEventListener("load", callback);
      return;
    }

    const script = document.createElement("script");
    script.src = src;
    script.onload = callback;
    script.onerror = function () {
      document.querySelectorAll(".campaign-map").forEach(function (container) {
        container.innerHTML = "<div style='padding: 1rem; color: #ff6666;'>Leaflet failed to load.</div>";
      });
    };
    document.head.appendChild(script);
  }

  function createMarkerIcon(color) {
    const markerColor = color || "#2f80ed";

    return L.divIcon({
      className: "campaign-map-pin",
      html:
        "<div style='" +
        "width: 18px; " +
        "height: 18px; " +
        "background: " + markerColor + "; " +
        "border: 2px solid white; " +
        "border-radius: 50% 50% 50% 0; " +
        "transform: rotate(-45deg); " +
        "box-shadow: 0 2px 6px rgba(0,0,0,0.45);" +
        "'></div>",
      iconSize: [22, 22],
      iconAnchor: [11, 22],
      popupAnchor: [0, -22]
    });
  }

  function initCampaignMaps() {
    document.querySelectorAll("#campaign-map, .campaign-map").forEach(function (container) {
      if (container.dataset.initialized === "true") return;
      container.dataset.initialized = "true";

      let mapWidth = Number(container.dataset.mapWidth || 0);
      let mapHeight = Number(container.dataset.mapHeight || 0);
      const explicitSrc = container.dataset.mapSrc;
      const imageName = container.dataset.mapImage;
      const renderedImage = imageName
        ? document.querySelector('img[src*="' + imageName + '"]')
        : null;

      const mapImageUrl = explicitSrc || renderedImage?.src;

      if (!mapImageUrl) {
        container.innerHTML = "<div style='padding: 1rem; color: #ff6666;'>Map image URL not found. Add data-map-src to the map container.</div>";
        return;
      }

      const map = L.map(container, {
        crs: L.CRS.Simple,
        minZoom: -5,
        maxZoom: 4,
        zoomControl: true,
        maxBoundsViscosity: 0.5
      });

      const image = new Image();

      image.onload = function () {
        if (!mapWidth) mapWidth = image.naturalWidth;
        if (!mapHeight) mapHeight = image.naturalHeight;

        const bounds = [[0, 0], [mapHeight, mapWidth]];

        L.imageOverlay(mapImageUrl, bounds).addTo(map);
        map.setMaxBounds(bounds);
        map.fitBounds(bounds, { padding: [10, 10] });

        setTimeout(function () {
          map.invalidateSize();
          map.fitBounds(bounds, { padding: [10, 10] });
        }, 250);
      };

      image.onerror = function () {
        container.innerHTML = "<div style='padding: 1rem; color: #ff6666;'>Map image failed to load: " + mapImageUrl + "</div>";
      };

      image.src = mapImageUrl;

      const markers = Array.from(document.querySelectorAll(".campaign-map-marker")).map(function (markerElement) {
        return {
          name: markerElement.dataset.name,
          x: Number(markerElement.dataset.x),
          y: Number(markerElement.dataset.y),
          url: markerElement.dataset.url,
          description: markerElement.dataset.description || "",
          color: markerElement.dataset.color || "#2f80ed"
        };
      }).filter(function (marker) {
        return marker.name && !Number.isNaN(marker.x) && !Number.isNaN(marker.y);
      });

      markers.forEach(function (marker) {
        L.marker([marker.y, marker.x], { icon: createMarkerIcon(marker.color) })
          .addTo(map)
          .bindPopup(
            "<strong>" + marker.name + "</strong><br>" +
            marker.description + "<br>" +
            "<a href='" + marker.url + "'>Open note</a>"
          );
      });

      map.on("click", function (event) {
        const x = Math.round(event.latlng.lng);
        const y = Math.round(event.latlng.lat);
        console.log("Map coordinates: x=" + x + ", y=" + y);

        L.popup()
          .setLatLng(event.latlng)
          .setContent("x: " + x + "<br>y: " + y)
          .openOn(map);
      });
    });
  }

  function start() {
    loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js", initCampaignMaps);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
</script>
