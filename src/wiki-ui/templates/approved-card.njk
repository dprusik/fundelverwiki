<a class="entry-card" data-approved-id="{{ entry.id | escape }}" href="{{ entry.url | escape }}">{% if entry.thumbnail %}{% if entry.thumbnail.kind == 'character' %}<div class="entry-card-character"><div class="entry-card-character-portrait"><img class="entry-card-thumb entry-card-thumb--character{% if entry.thumbnail.fromArticle %} entry-card-thumb--from-article{% endif %}" src="{{ entry.thumbnail.src | escape }}" alt="" width="96" height="116" loading="lazy" decoding="async"></div><div class="entry-card-character-copy">{% else %}<img class="entry-card-thumb entry-card-thumb--{{ entry.thumbnail.kind | escape }}" src="{{ entry.thumbnail.src | escape }}" alt="" loading="lazy" decoding="async">{% endif %}{% endif %}<p class="eyebrow">{{ entry.kindLabel | escape }}</p><h2>{{ entry.title | escape }}</h2>{% if entry.kind == 'map' %}<span class="text-link">Otwórz mapę →</span>{% else %}<span class="text-link">Czytaj wpis →</span>{% endif %}{% if entry.thumbnail and entry.thumbnail.kind == 'character' %}</div></div>{% endif %}</a>
