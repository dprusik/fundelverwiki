<article class="entry-card" data-character-id="{{ entry.id }}"><span class="avatar" aria-hidden="true">{{ entry.title | first }}</span><h3><a href="{{ entry.url }}">{{ entry.title | escape }}</a></h3><p>{{ entry.summary | escape }}</p><div class="chips">{% for edge in entry.id | relationsFrom %}{% set target = edge.target | entry %}<a href="{{ target.url }}">{{ target.title | escape }}</a>{% endfor %}</div></article>
