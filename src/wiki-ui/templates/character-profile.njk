{% set profile = entity %}{% set profileDemo = true %}{% include 'entity-header.njk' %}
<section class="profile-connections" aria-labelledby="connections-heading">
  <div class="section-heading"><h2 id="connections-heading">Publiczne powiązania</h2></div>
  <div class="profile-connection-grid">
    {% for relationType, heading in {member_of: 'Frakcje i organizacje', located_in: 'Powiązane lokacje'} %}
    <div><h3>{{ heading }}</h3><ul class="related-list">
      {% set hasConnections = false %}
      {% for edge in entity.id | relationsFrom %}{% if edge.type == relationType %}
      {% set hasConnections = true %}{% set target = edge.target | entry %}
      <li><a href="{{ target.url }}">{{ target.title | escape }} <span aria-hidden="true">↗</span></a>{% if edge.description %}<p>{{ edge.description | escape }}</p>{% endif %}</li>
      {% endif %}{% endfor %}
      {% if not hasConnections %}<li>Brak publicznie ujawnionych powiązań.</li>{% endif %}
    </ul></div>
    {% endfor %}
  </div>
</section>
<section aria-labelledby="description-heading"><div class="section-heading"><h2 id="description-heading">Opis postaci</h2></div><article class="prose profile-body">{{ entity.body | markdown | safe }}</article></section>
